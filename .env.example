# Copy to .env and fill in. docker compose reads this file automatically.
# Single-domain production: everything is served from https://mydomain.com
#   /api/*, /oidc/*, /mcp, /.well-known/*  -> expenses-server
#   everything else                         -> expense-web (frontend)

# --- expenses-server (runtime) ---
SERVER_URL=https://mydomain.com
LR_ISSUER=https://<tenant>.devhub.lrinternal.com/service/oidc/<app-name>
LR_INTROSPECT_URL=https://<tenant>.devhub.lrinternal.com/service/oidc/<app-name>/introspect
LR_JWKS_URI=https://<tenant>.devhub.lrinternal.com/service/oidc/<app-name>/jwks
LR_CLIENT_ID=
LR_CLIENT_SECRET=
LR_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
LR_TOKEN_ENDPOINT=https://<tenant>.devhub.lrinternal.com/service/oauth/token
LR_OIDC_TOKEN_ENDPOINT=https://<tenant>.devhub.lrinternal.com/service/oidc/<app-name>/token
LR_AUTHORIZE_URL=https://<tenant>.devhub.lrinternal.com/service/oidc/<app-name>/authorize
LR_USERINFO_ENDPOINT=https://<tenant>.devhub.lrinternal.com/service/oidc/<app-name>/userinfo
LR_MCP_ISSUER=https://<tenant>.devhub.lrinternal.com/service/oidc/<app-name>
OIDC_REDIRECT_URI=https://mydomain.com/callback
REST_RESOURCE_URL=https://mydomain.com
REST_BASE_URL=https://mydomain.com
MCP_RESOURCE_URL=https://mydomain.com/mcp
PROTECTED_RESOURCE_METADATA={"authorization_servers":["https://<tenant>.devhub.lrinternal.com/service/oidc/<app-name>"],"bearer_methods_supported":["header"],"resource":"https://mydomain.com/mcp","scopes_supported":["mcp:tools","openid","email","expense:submit","expense:view:own","expense:view:team","expense:view:all","expense:approve","expense:report:generate"]}
CORS_ORIGIN=https://mydomain.com

# --- expense-web (build-time, baked into the static bundle by Vite) ---
VITE_LR_AUTHORIZE_URL=https://<tenant>.devhub.lrinternal.com/service/oidc/<app-name>/authorize
VITE_LR_CLIENT_ID=
VITE_LR_REDIRECT_URI=https://mydomain.com/callback
VITE_REST_RESOURCE_URL=https://mydomain.com
