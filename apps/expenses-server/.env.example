# ======================
# Server Configuration
# ======================
PORT=3000
NODE_ENV=development
SERVER_URL=http://localhost:3000

# ======================
# Scalekit Configuration
# ======================
# Required: Get from Scalekit Dashboard -> Settings -> API Credentials
SCALEKIT_ENV_URL=https://your-env.scalekit.com
SCALEKIT_CLIENT_ID=your_client_id_here
SCALEKIT_CLIENT_SECRET=your_client_secret_here

# Required: MCP server config for Scalekit OAuth discovery
MCP_SERVER_URL=http://localhost:3000/
PROTECTED_RESOURCE_METADATA={"authorization_servers":["https://your-env.scalekit.com/resources/your-resource-id"],"bearer_methods_supported":["header"],"resource":"http://localhost:3000/","scopes_supported":["expense:submit","expense:view:own","expense:view:team","expense:view:all","expense:approve","expense:report:generate"]}

# ======================
# Database Configuration
# ======================
DATABASE_PATH=./data/expense.db

# ======================
# MCP Configuration
# ======================
MCP_SERVER_NAME=Expense Management MCP Server
MCP_SERVER_VERSION=1.0.0

# ======================
# CORS Configuration
# ======================
CORS_ORIGIN=*
