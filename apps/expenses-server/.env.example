# ======================
# Server Configuration
# ======================
PORT=3000
NODE_ENV=development
SERVER_URL=http://localhost:3000

# ======================
# LoginRadius Configuration
# ======================
# Required: LoginRadius dev OIDC/MCP app credentials
LR_ISSUER=https://dev-tenant.devhub.lrinternal.com/service/oauth/your-app
LR_INTROSPECT_URL=https://dev-tenant.devhub.lrinternal.com/api/oauth/your-app/introspect
LR_JWKS_URI=https://dev-tenant.devhub.lrinternal.com/service/oauth/your-app/jwks
LR_CLIENT_ID=your_client_id_here
LR_CLIENT_SECRET=your_client_secret_here
LR_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post

# Required: MCP resource server config for protected resource metadata
MCP_RESOURCE_URL=http://localhost:3000/mcp
PROTECTED_RESOURCE_METADATA={"authorization_servers":["https://dev-tenant.devhub.lrinternal.com/service/oauth/your-app"],"bearer_methods_supported":["header"],"resource":"http://localhost:3000/mcp","scopes_supported":["mcp:tools"]}

# ======================
# Database Configuration
# ======================
DATABASE_PATH=./data/expense.db

# ======================
# MCP Configuration
# ======================
MCP_SERVER_NAME=Expense Management MCP Server
MCP_SERVER_VERSION=1.0.0

# ======================
# CORS Configuration
# ======================
CORS_ORIGIN=*
