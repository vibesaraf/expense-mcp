# Server Config
PORT=3001
DATABASE_PATH=./data/expense.db
NODE_ENV=development
CORS_ORIGIN=*

# LoginRadius configuration
LR_ISSUER=https://<your-tenant>.devhub.lrinternal.com/service/oidc/<app-name>
# Issuer of service / token-exchange tokens. Must match the token `iss` claim
# byte-for-byte (including any trailing slash). REST-only; MCP rejects it.
LR_SERVICE_ISSUER=https://<your-tenant>.devhub.lrinternal.com/service/oauth/
LR_INTROSPECT_URL=https://<your-tenant>.devhub.lrinternal.com/service/oidc/<app-name>/introspect
LR_JWKS_URI=https://<your-tenant>.devhub.lrinternal.com/service/oidc/<app-name>/jwks
LR_CLIENT_ID=
LR_CLIENT_SECRET=
LR_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
LR_TOKEN_ENDPOINT=https://<your-tenant>.devhub.lrinternal.com/service/oauth/token
LR_AUTHORIZE_URL=https://<your-tenant>.devhub.lrinternal.com/service/oidc/<app-name>/authorize

# MCP Server Configuration
SERVER_URL=http://localhost:3001
MCP_RESOURCE_URL=http://localhost:3001/mcp
PROTECTED_RESOURCE_METADATA={"authorization_servers":["https://<your-tenant>.devhub.lrinternal.com/service/oidc/<app-name>"],"bearer_methods_supported":["header"],"resource":"http://localhost:3001/mcp","resource_documentation":"http://localhost:3001/docs","scopes_supported":["mcp:tools","openid","email","expense:submit","expense:view:own","expense:view:team","expense:view:all","expense:approve","expense:report:generate"]}
# MCP_SERVER_ACTOR_SCOPES defaults to all six expense:* scopes — override only if narrowing

# REST Resource (audience for direct REST API tokens)
REST_RESOURCE_URL=http://localhost:3001
REST_BASE_URL=http://localhost:3001

# OIDC callback for React client
OIDC_REDIRECT_URI=http://localhost:5173/callback

# Cookie (COOKIE_SECURE is derived from NODE_ENV=production — not set here)
COOKIE_NAME=expense_session
